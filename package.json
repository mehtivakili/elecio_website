{
  "name": "elecio-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/phone.test.ts tests/rbac.test.ts tests/staff-policy.test.ts tests/content-document.test.ts tests/telemetry.test.ts",
    "db:migrate": "node -r dotenv/config -r tsx/cjs ./node_modules/knex/bin/cli.js --knexfile src/server/db/knexfile.ts migrate:latest",
    "db:migrate:rollback": "node -r dotenv/config -r tsx/cjs ./node_modules/knex/bin/cli.js --knexfile src/server/db/knexfile.ts migrate:rollback",
    "db:migrate:make": "node -r dotenv/config -r tsx/cjs ./node_modules/knex/bin/cli.js --knexfile src/server/db/knexfile.ts migrate:make",
    "db:seed": "node -r dotenv/config -r tsx/cjs ./node_modules/knex/bin/cli.js --knexfile src/server/db/knexfile.ts seed:run",
    "staff:bootstrap-owner": "tsx scripts/bootstrap-owner.ts",
    "dev:seed-admin": "tsx scripts/dev-admin.ts",
    "dev:remove-admin": "tsx scripts/dev-admin.ts remove",
    "content:seed-initial": "tsx scripts/seed-initial-blogs.ts",
    "content:import-en-ec-001": "tsx scripts/import-en-ec-001.ts",
    "content:import-fa-ec-001": "tsx scripts/import-fa-ec-001.ts"
  },
  "dependencies": {
    "@ant-design/icons": "^6.3.2",
    "@ant-design/nextjs-registry": "^1.3.0",
    "@tiptap/extension-image": "3.30.0",
    "@tiptap/extension-link": "3.30.0",
    "@tiptap/react": "3.30.0",
    "@tiptap/starter-kit": "3.30.0",
    "@types/qrcode": "1.5.6",
    "antd": "^6.5.3",
    "better-auth": "1.6.22",
    "dotenv": "^17.4.2",
    "knex": "^3.3.0",
    "kysely": "0.28.17",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "objection": "^3.1.5",
    "pg": "^8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "redis": "^5.8.2",
    "server-only": "^0.0.1",
    "sharp": "0.35.3",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.4",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.23.8",
    "typescript": "^5"
  }
}
