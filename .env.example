# Copy this file to .env (gitignored) and fill in real values.
# Next.js loads .env automatically at runtime; the `db:*` npm scripts load it for the Knex CLI
# too via `-r dotenv/config`, so one file covers both instead of juggling .env vs .env.local.

# --- Database (required — MySQL 8.0.16+) ---
# Use a dedicated database and least-privilege account. Keep the connection timezone on UTC and
# utf8mb4 enabled so application dates and Persian/English text behave consistently.
DATABASE_URL=mysql://elecio_app:CHANGE_ME@localhost:3306/elecio_dev?timezone=Z&charset=utf8mb4

# --- App ---
NODE_ENV=development

# --- Authentication (required for Expansion Phase 1+) ---
# Generate a unique production secret with at least 32 random bytes. Never reuse this example.
BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated exact origins; do not use wildcards for production auth.
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000

# Auth trusts no proxy-specific client-IP header unless explicitly configured for the chosen host.
# Examples after verifying the proxy overwrites the header: cf-connecting-ip or x-real-ip.
AUTH_IP_ADDRESS_HEADERS=

# --- Shared auth/session/rate-limit storage (required) ---
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=elecio:development

# --- Privacy-preserving request signals ---
# Independent random secret used only for one-way IP hashing in audit/form signals.
IP_HASH_SALT=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

# --- Customer OTP / SMS (required for Expansion Phase 2 live delivery) ---
# Keep disabled in development unless you intentionally want to send real messages.
# disabled (fail closed), development (non-sending; never use in production), or kavenegar
SMS_PROVIDER=disabled
KAVENEGAR_API_KEY=
KAVENEGAR_OTP_TEMPLATE=elecio-login
# Emergency registration/SMS kill switch. Set false during an incident or spend anomaly.
CUSTOMER_REGISTRATION_ENABLED=true

# --- Staff authentication and transactional email (Expansion Phase 3) ---
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
STAFF_EMAIL_FROM=Elecio Security <security@example.com>
# Set only while running `npm run staff:bootstrap-owner`, then remove the password immediately.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_PASSWORD=

# --- SEO (public site origin + search-engine verification) ---
# Canonical public origin used for sitemap/canonical/hreflang/OG absolute URLs and JSON-LD.
# Without this set, src/lib/seo.ts falls back to BETTER_AUTH_URL, then https://elecio.ir.
NEXT_PUBLIC_SITE_URL=https://elecio.ir
# HTML-tag ownership verification codes for Search Console / Bing Webmaster / Yandex Webmaster.
# Paste only the token value (not the full <meta> tag). Leave blank until verifying each console;
# unset values are omitted from rendered metadata rather than shipping an empty tag.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# --- Explicitly insecure local demo account (development only) ---
# Enables `npm run dev:seed-admin` for admin@admin / admin. Never enable on a shared, staging, or
# production deployment. If REDIS_URL is absent, this exact local-demo mode also permits an
# in-process auth store that is lost on restart. Run `npm run dev:remove-admin` and remove this flag
# before launch. Every other mode still fails closed without Redis.
ALLOW_INSECURE_DEV_ADMIN=false
